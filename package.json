{
  "name": "dsh-session-memory",
  "version": "1.3.1",
  "description": "Local DeepSeek Harness memory with separate stores: a global INI identity, a bounded/versioned persona memory, per-workspace work facts, and interaction habits. Optionally reads work records across workspaces without ever sharing identity/persona data.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "identity.js",
    "persona.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "USAGE.md",
    "ARCHITECTURE.md",
    "examples/*"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "author": "dsh-session-memory contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/user33272/dsh-session-memory.git"
  },
  "homepage": "https://github.com/user33272/dsh-session-memory#readme",
  "bugs": {
    "url": "https://github.com/user33272/dsh-session-memory/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-memory",
    "context",
    "memory",
    "habits",
    "identity",
    "persona"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  }
}
